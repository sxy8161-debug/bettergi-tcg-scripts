(function(root){
  "use strict";
  const T=root.TCG;
  /* @include src/shared/lifecycle.inc.js#lifecycle.BOARD_RETRIES */
  /* @include src/shared/lifecycle.inc.js#lifecycle.INPUT_REFRESHES */
  /* @include src/shared/lifecycle.inc.js#lifecycle.BUDGET_FIELDS */
  /* @include src/shared/lifecycle.inc.js#lifecycle.playerOptions */
  class Player {
    /* @include src/shared/lifecycle.inc.js#lifecycle.constructor */
    /* @include src/shared/lifecycle.inc.js#lifecycle.progress */
    /* @include src/shared/lifecycle.inc.js#lifecycle.notice */
    /* @include src/shared/lifecycle.inc.js#lifecycle.checkStalled */
    /* @include src/shared/lifecycle.inc.js#lifecycle.defer */
    /* @include src/shared/lifecycle.inc.js#lifecycle.finishOpening */
    /* @include src/shared/lifecycle.inc.js#lifecycle.admitActionHand */
    /* @include src/shared/lifecycle.inc.js#lifecycle.enter */
    /* @include src/shared/lifecycle.inc.js#lifecycle.opening */
    /* @include src/shared/lifecycle.inc.js#lifecycle.choice */
    /* @include src/shared/lifecycle.inc.js#lifecycle.replacement */
    /* @include src/shared/lifecycle.inc.js#lifecycle.pick */
    /* @include src/shared/lifecycle.inc.js#lifecycle.roll */
    /* @include src/shared/lifecycle.inc.js#lifecycle.observe */
    /* @include src/shared/lifecycle.inc.js#lifecycle.execute */
    /* @include src/shared/lifecycle.inc.js#lifecycle.rejectUnchangedTune */
    /* @include src/shared/lifecycle.inc.js#lifecycle.recoverRejectedInput */
    /* @include src/shared/lifecycle.inc.js#lifecycle.awaitConfirmation */
    /* @include src/shared/lifecycle.inc.js#lifecycle.awaitObservation */
    /* @include src/shared/lifecycle.inc.js#lifecycle.recoverBeforeConfirmation */
    /* @include src/shared/lifecycle.inc.js#lifecycle.run */
    reportResult(p){log.info(p.result==="win"?"对局胜利":"对局失败");}
    planOpening(stage){const target=T.role("菈乌玛");this.memory.openingTarget=target;
      if(this.memory.round===0){this.memory.countdownStock={countdown3:2};this.memory.kernelLedger={created:0,unspent:0};}
      this.host.trace("opening-character-plan",{target,stage:stage||"initial-pick",source:"configured-team-order"});return {target};}
    /* @include src/shared/lifecycle.inc.js#lifecycle.act */
  }
  const axisNames={burst:"爆发兑现",fallback:"低组件保底",reaction:"补反应铺垫",relay:"少女接力",sustain:"持续输出",cleanup:"残局收尾"};
  const skillNames={NA:"普攻",E:"战技",Q:"爆发",T:"特技"};
  function plannedActionLabel(key){
    const [type,id,name,technique]=key.split(":");
    if(type==="skill")return T.team[Number(id)].name+(name==="T"?"的「"+T.techniques[technique].name+"」":skillNames[name]);
    if(type==="switch")return "切换"+T.team[Number(id)].name;
    if(type==="card")return "使用「"+T.byId[id].name+"」";
    return "调和「"+T.byId[id].name+"」";
  }
  function actionCommentary(a,s,m){
    const prefix="【"+axisNames[a.axis||T.axis(s,m)]+"】";
    let text;
    if(a.type==="probe")text=a.scope==="card"?"查看「"+T.byId[a.id].name+"」，安排手牌的使用顺序":
      "查看"+T.team[a.who].name+"的"+skillNames[a.skill]+"费用，安排接下来的输出";
    else if(a.type==="skill"){
      const hit=T.damageEstimate(s,m,a.who,a.skill);
      text=T.team[a.who].name+"准备使用"+(a.skill==="T"?"特技「"+T.techniques[a.technique].name+"」":skillNames[a.skill]);
      if(hit.direct>0)text+="，预计造成"+hit.direct+"点伤害";
      else text+="，优先为后续反应与资源转换铺垫";
    }else if(a.type==="switch")text="准备切换"+T.team[a.target].name+"接力";
    else if(a.type==="tune")text="调和「"+T.byId[a.id].name+"」"+(a.funding?"，为"+plannedActionLabel(a.funding.goal)+"筹集有效骰":"，将无效骰转换为当前角色所需元素");
    else if(a.type==="card"){
      const c=T.byId[a.id],purpose={weapon:"准备武器与后续输出",artifact:"准备后续资源收益",support:"铺设后续资源转换",legend:"按当前资源选择生成牌",
        attachment:"调整手牌附着与费用",switch:"准备免费切换",draw:"补充手牌",energy:"转移充能，为爆发创造条件",
        return:"回收武器并重新利用减费",choice:"选择接下来要用的牌",adventure:"准备后续回合资源",dice:"补充可用骰子",
        status:"准备后续行动的资源收益",food:"准备当前增益或续航",kernel:"兑现核的幻戏攻击",branch:"处理祝佑分支效果",
        technique:"装备特技，准备后续输出","heal-dice":"兼顾续航与骰子资源",heal:"恢复生命，保留后续接力"}[c.type];
      text="准备使用「"+c.name+"」"+(T.characterTarget(c)?"，目标"+T.team[a.target].name:"")+"，"+purpose;
    }else text="结束回合，准备下一轮";
    if(a.planning?.sequence.length>1)text+="；接下来准备："+a.planning.sequence.slice(1,4).map(plannedActionLabel).join(" → ");
    if(a.planning?.terminal)text+="；争取这一轮收尾";
    return prefix+text+"。";
  }
  root.TCGPlayer={Player,playerOptions,actionCommentary};
})(globalThis);
